# .gitignore для Unity-проекта
# Этот файл должен находиться в корне каталога проекта

# Папки, которые Unity генерирует сам (их не нужно коммитить)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Файлы, которые могут быстро разрастаться и иногда содержат чувствительные данные
/[Rr]ecordings/
/[Mm]emoryCaptures/

# Метаданные ассетов (важно: не игнорируйте `.meta`, если сам асссет тоже игнорируется!)
!/[Aa]ssets/**/*.meta

# Опционально: игнорирование плагина Asset Store Tools
#/[Aa]ssets/AssetStoreTools*

# Дополнительные правила для других инструментов (если используете)
*.svd
*.userprefs
*.csproj
*.pidb
*.suo
*.sln
*.user
*.unityproj
*.booproj
